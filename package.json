  "description": "Agente local de impressão térmica para Windows — Cheffya / Menu Control",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "node build.js",
    "dev": "node src/index.js"
  },
  "dependencies": {
