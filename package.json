    "express": "^4.18.2",
    "systray2": "^2.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.11.5",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5"
  },
  "pkg": {
